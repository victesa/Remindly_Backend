NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASIC_MODEL=gemini-2.5-flash
GEMINI_ADVANCED_MODEL=gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_ADVANCED_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ENABLE_PROVIDER_FAILOVER=true
LLM_LOW_COST_MODE=false
LLM_DISABLE_ADVANCED_FALLBACK=false
LLM_MAX_INFERENCE_TEXT_LENGTH=12000
LLM_MAX_LLM_CALLS_PER_REQUEST=4
LLM_DEDUPE_TTL_SECONDS=300
# Optional: hard cap of AI-backed ingest requests per day per runtime instance
LLM_DAILY_REQUEST_BUDGET=
OCR_MIN_SCORE=0.45
DEFAULT_TIMEZONE=Africa/Nairobi
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_SIGNED_URL_TTL_SECONDS=900

# Test helper for fetching Firebase ID token via email/password
FIREBASE_WEB_API_KEY=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
